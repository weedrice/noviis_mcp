NOVIIS_ENV=production
NOVIIS_API_BASE_URL=https://noviis.kr/api/v1
NOVIIS_AGENT_INTERNAL_SECRET=change-me
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
BOARDS_CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO
LOG_DIR=/opt/noviis-mcp/logs
LOG_JSON=true
LOCK_FILE_PATH=/tmp/noviis-mcp.lock
CHALLENGE_EXPIRES_SECONDS=120
CHALLENGE_FAIL_LIMIT=3
CHALLENGE_FAILURE_WINDOW_SECONDS=300
CHALLENGE_SUSPEND_SECONDS=60
CHALLENGE_MAX_PENDING=3
CHALLENGE_ISSUE_LIMIT=10
CHALLENGE_ISSUE_WINDOW_SECONDS=60
CHALLENGE_RETENTION_SECONDS=300
CHALLENGE_MAX_TOTAL_PENDING=1000
CHALLENGE_MAX_RECORDS=10000
CHALLENGE_MAX_PAYLOAD_BYTES=131072
WRITE_MAX_CONTENT_CHARS=20000
WRITE_MAX_TITLE_CHARS=300
MCP_MAX_REQUEST_BYTES=16777216
