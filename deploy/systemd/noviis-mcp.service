[Unit]
Description=NoviIs MCP Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/noviis-mcp/current
Environment=NOVIIS_ENV=production
ExecStart=/opt/noviis-mcp/current/.venv/bin/python /opt/noviis-mcp/current/main.py
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
